# Bu dosyayi VM'de `.env` olarak kopyalayip doldur:  cp env.ornek .env
# .env'i ASLA git'e ekleme.

# DuckDNS'ten aldigin ucretsiz alan adi (tamami)
DOMAIN=focusaid-n8n.duckdns.org

# duckdns.org'a Google ile girince sayfanin ustunde yazan token
DUCKDNS_TOKEN=

# Let's Encrypt sertifikasi icin (sadece bildirim adresi)
ACME_EMAIL=bilaltarikd@gmail.com

# CORS: FocusAid'in canli adresi. Buraya yazmadigin hicbir site
# bu n8n'e tarayicidan istek atamaz.
FRONTEND_ORIGIN=https://dehb-asistan.onrender.com

# n8n credential sifreleme anahtari.
# Uret:  openssl rand -hex 32
# SONRADAN DEGISTIRME — kayitli credential'lar okunamaz hale gelir.
N8N_ENCRYPTION_KEY=
